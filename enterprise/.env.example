# Enterprise defaults — copy to enterprise/.env before install

ADUPORT_REQUIRE_AUTH=1
ADUPORT_API_KEY=
# install.sh fills a random API key when empty / placeholder. Do not ship change-me.
# Or multi-tenant keys: ADUPORT_API_KEYS=acme:sk-xxx,beta:sk-yyy

ADUPORT_MAX_UPLOAD_MB=100
ADUPORT_OCR_ENABLED=false
ADUPORT_PDF_ENGINE=auto
ADUPORT_DOCLING_OFFLINE=true
ADUPORT_DOCLING_ARTIFACTS_PATH=/data/docling/models
ADUPORT_DEBUG=false

# Optional scan OCR (install aduport[ocr-mineru] / [ocr-paddle] on GPU hosts)
# ADUPORT_OCR_ENABLED=true
# ADUPORT_OCR_ENGINE=auto
# ADUPORT_OCR_MODE=balanced
# ADUPORT_OCR_FALLBACK=paddleocr_vl
# ADUPORT_MINERU_FORMULA=false
# ADUPORT_OCR_HOME=/data/ocr_home
# See enterprise/OCR.md

# RAG / embedding (optional) — see enterprise/RAG.md
# ADUPORT_RAG_MAX_CHARS=1200
# ADUPORT_EMBED_BACKEND=hash
# ADUPORT_EMBED_DEFAULT=false
# ADUPORT_VECTOR_DIR=/data/vectors
# ADUPORT_JOB_RETAIN_INPUT_ON_DONE=true

ADUPORT_CORS_ORIGINS=local
ADUPORT_RATE_LIMIT_PER_MINUTE=120
# Multi-worker / HA: shared rate limit + session revoke + license seats
# ADUPORT_REDIS_URL=redis://redis:6379/0
# Session HMAC (≥16 required for signed cookies; no hardcoded fallback — v13 P1-1)
ADUPORT_SESSION_SECRET=
# ADUPORT_SESSION_TTL_SECONDS=604800
# Cookie Secure (default true). Set 0 only for plain-HTTP local demos.
# ADUPORT_COOKIE_SECURE=1

ADUPORT_JOB_DB_PATH=/data/jobs.sqlite3
ADUPORT_JOB_TTL_SECONDS=86400
ADUPORT_AUDIT_ENABLED=true
ADUPORT_AUDIT_LOG_PATH=/data/logs/audit.jsonl

ADUPORT_VIRUS_SCAN=false
ADUPORT_VIRUS_SCAN_FAIL_CLOSED=true

# Soft cap for oversized DOCX AST (mitigation, not algorithm fix)
ADUPORT_DOCX_MAX_NODES=50000

ADUPORT_FETCH_REMOTE_IMAGES=false
ADUPORT_CACHE_ENABLED=true
ADUPORT_WARMUP_ON_STARTUP=false

# Vendored anydoc → aduport_native (compiled into enterprise image by default)
ADUPORT_ANYDOC_ENABLED=true
ADUPORT_ANYDOC_FORMATS=doc,docx,rtf,odt,pptx,ppt,pps,pot,pptm,ppsx,ppsm,docm,epub,csv
ADUPORT_ANYDOC_FAST_MARKDOWN=true
ADUPORT_ANYDOC_PDF_MARKDOWN=true
ADUPORT_ANYDOC_FALLBACK=true
ADUPORT_ANYDOC_SNIFF=true

# One-machine-one-key (enterprise). install.sh generates LICENSE_SECRET.
ADUPORT_LICENSE_REQUIRED=true
ADUPORT_LICENSE_SECRET=
ADUPORT_LICENSE_KEY=
# ADUPORT_LICENSE_FILE=/data/license.key

# Optional: push conversion meters to your billing system (IP-pinned POST)
# ADUPORT_BILLING_WEBHOOK_URL=https://billing.example.com/hooks/AduPort
# ADUPORT_BILLING_WEBHOOK_TIMEOUT_SECONDS=5
