# Enterprise defaults — copy to enterprise/.env before install

MDBRIDGE_API_KEY=change-me-before-production
# Or multi-tenant keys: MDBRIDGE_API_KEYS=acme:sk-xxx,beta:sk-yyy

MDBRIDGE_MAX_UPLOAD_MB=100
MDBRIDGE_OCR_ENABLED=false
MDBRIDGE_PDF_ENGINE=auto
MDBRIDGE_DOCLING_OFFLINE=true
MDBRIDGE_DOCLING_ARTIFACTS_PATH=/data/docling/models
MDBRIDGE_DEBUG=false

# Optional scan OCR (install md-bridge[ocr-mineru] / [ocr-paddle] on GPU hosts)
# MDBRIDGE_OCR_ENABLED=true
# MDBRIDGE_OCR_ENGINE=auto
# MDBRIDGE_OCR_MODE=balanced
# MDBRIDGE_OCR_FALLBACK=paddleocr_vl
# MDBRIDGE_MINERU_FORMULA=false
# MDBRIDGE_OCR_HOME=/data/ocr_home
# See enterprise/OCR.md

MDBRIDGE_CORS_ORIGINS=local
MDBRIDGE_RATE_LIMIT_PER_MINUTE=120

MDBRIDGE_JOB_DB_PATH=/data/jobs.sqlite3
MDBRIDGE_JOB_TTL_SECONDS=86400
MDBRIDGE_AUDIT_ENABLED=true
MDBRIDGE_AUDIT_LOG_PATH=/data/logs/audit.jsonl

MDBRIDGE_VIRUS_SCAN=false
MDBRIDGE_VIRUS_SCAN_FAIL_CLOSED=true

# Soft cap for oversized DOCX AST (mitigation, not algorithm fix)
MDBRIDGE_DOCX_MAX_NODES=50000

MDBRIDGE_FETCH_REMOTE_IMAGES=false
MDBRIDGE_CACHE_ENABLED=true
MDBRIDGE_WARMUP_ON_STARTUP=false

# Vendored anydoc → mdbridge_native (compiled into enterprise image by default)
MDBRIDGE_ANYDOC_ENABLED=true
MDBRIDGE_ANYDOC_FORMATS=doc,docx,rtf,odt,pptx,ppt,pps,pot,pptm,ppsx,ppsm,docm,epub,csv
MDBRIDGE_ANYDOC_FAST_MARKDOWN=true
MDBRIDGE_ANYDOC_FALLBACK=true
MDBRIDGE_ANYDOC_SNIFF=true

# One-machine-one-key (enterprise)
MDBRIDGE_LICENSE_REQUIRED=true
MDBRIDGE_LICENSE_SECRET=change-me-shared-with-issuer
MDBRIDGE_LICENSE_KEY=
# MDBRIDGE_LICENSE_FILE=/data/license.key
