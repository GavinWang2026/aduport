# AduPort environment configuration
# Copy to .env and adjust. Prefix: ADUPORT_
# Enterprise private deploy: see enterprise/.env.example and enterprise/README.md

ADUPORT_MAX_UPLOAD_MB=100
# Optional: scan OCR fixtures (image-only PDFs)
# python scripts/gen_scan_fixtures.py
# pytest -q -m integration tests/test_scan_ocr_regression.py
ADUPORT_OCR_ENABLED=false
# auto | mineru | paddleocr_vl | docling — see enterprise/OCR.md
ADUPORT_OCR_ENGINE=auto
ADUPORT_OCR_MODE=balanced
ADUPORT_OCR_FALLBACK=paddleocr_vl
ADUPORT_OCR_MIN_CHARS=40
ADUPORT_OCR_TIMEOUT_SECONDS=300
ADUPORT_OCR_MAX_PAGES=20
ADUPORT_MINERU_BIN=mineru
ADUPORT_MINERU_BACKEND=pipeline
ADUPORT_MINERU_FORMULA=false
ADUPORT_MINERU_TABLE=true
# Writable cache for PaddleX / ModelScope (e.g. .paddle_home)
ADUPORT_OCR_HOME=
# auto | true | false — auto disables Paddle on macOS (avoids SIGTRAP crash dialogs)
ADUPORT_OCR_ALLOW_PADDLE=auto

# PDF engine: auto | text | docling | mineru | paddleocr_vl
ADUPORT_PDF_ENGINE=auto
# When models are local, auto prefers docling over flat text-layer (structure fidelity)
ADUPORT_PDF_AUTO_PREFER_DOCLING=true
ADUPORT_PDF_TEXT_MIN_CHARS=80
# Two-column PDF text heuristic (left/right half merge when both populated)
ADUPORT_PDF_TEXT_MULTICOLUMN=true
ADUPORT_HF_ENDPOINT=https://hf-mirror.com
ADUPORT_DOCLING_OFFLINE=true
ADUPORT_DEBUG=false

ADUPORT_CORS_ORIGINS=local
ADUPORT_CORS_ALLOW_CREDENTIALS=false

# Optional API key (empty = disabled). When set, send header X-API-Key.
# Fail-closed auth (production default). Never set 0 in private deploy/.env loaded by compose.
ADUPORT_REQUIRE_AUTH=1
ADUPORT_API_KEY=
# Multi-tenant: JSON file path, inline JSON, or tenant:key,tenant2:key2
ADUPORT_API_KEYS=

ADUPORT_PDF_FONT_FAMILY="Songti SC, STSong, Noto Sans CJK SC, sans-serif"
# Keep only the first named face (+ generic) at export time to avoid multi-CJK embeds.
ADUPORT_PDF_FONT_COMPACT=true
ADUPORT_PDF_CUSTOM_CSS=

ADUPORT_MAX_BATCH_FILES=20
ADUPORT_MAX_BATCH_TOTAL_MB=200
ADUPORT_BATCH_WORKERS=3

ADUPORT_RATE_LIMIT_PER_MINUTE=60
# Multi-worker: set Redis so rate limits / session revoke / license seats are shared
ADUPORT_REDIS_URL=
# Session cookie TTL (seconds); default 7 days.
# Required for multi-worker HMAC sessions (≥16). No hardcoded fallback (v13 P1-1).
# ADUPORT_SESSION_TTL_SECONDS=604800
ADUPORT_SESSION_SECRET=
# Cookie Secure flag (default true). Set 0 only for plain-HTTP local demos.
# ADUPORT_COOKIE_SECURE=1

ADUPORT_CACHE_ENABLED=true
ADUPORT_CACHE_MAX_ENTRIES=128
ADUPORT_CACHE_TTL_SECONDS=3600

ADUPORT_AUDIT_ENABLED=true
ADUPORT_AUDIT_LOG_PATH=logs/audit.jsonl

ADUPORT_MAGIC_BYTES_CHECK=true

ADUPORT_PDF_CJK_TYPESET=true
ADUPORT_PDF_PAGE_SIZE=A4
ADUPORT_PDF_ORIENTATION=portrait
ADUPORT_PDF_HEADER=
ADUPORT_PDF_FOOTER=
ADUPORT_PDF_PAGE_NUMBERS=true
ADUPORT_PDF_TOC=false

ADUPORT_FETCH_REMOTE_IMAGES=true
ADUPORT_FETCH_REMOTE_TIMEOUT=8
ADUPORT_FETCH_REMOTE_MAX_BYTES=5242880

ADUPORT_SPILL_THRESHOLD_MB=8
ADUPORT_CACHE_SKIP_REVALIDATE=true

ADUPORT_DOCX_THEME=default
# Soft cap for oversized DOCX AST
ADUPORT_DOCX_MAX_NODES=50000
# Emit Word comments.xml when AST has Comment nodes (default true)
ADUPORT_DOCX_EXPORT_COMMENTS=true
# Prefix headings with 1 / 1.1 / 1.1.1 on export
ADUPORT_HEADING_NUMBERING=false

ADUPORT_JOB_TTL_SECONDS=3600
ADUPORT_JOB_MAX_ENTRIES=256
ADUPORT_JOB_DB_PATH=data/jobs.sqlite3
# Persist job result blobs (survives restart within TTL); empty = memory/spill only
ADUPORT_JOB_RESULT_DIR=data/job_results
# Long-term archive (file:///path or s3://bucket/prefix; s3 needs boto3)
ADUPORT_OBJECT_STORAGE_URI=
ADUPORT_JOB_ARCHIVE_RETENTION_DAYS=30
# EPUB zip passphrase (password-protected zips only; not Adobe/LCP DRM)
ADUPORT_EPUB_PASSPHRASE=
ADUPORT_MEMORY_BUDGET_MB=512

# Job completion webhook (POST /api/jobs Form callback_url)
ADUPORT_WEBHOOK_ENABLED=true
ADUPORT_WEBHOOK_TIMEOUT_SECONDS=10
# Optional HMAC for receivers (header X-AduPort-Signature: sha256=<hex>)
ADUPORT_WEBHOOK_SECRET=
ADUPORT_WEBHOOK_RETRIES=2

# MCP local tool roots (comma-separated; empty = cwd; * = unrestricted)
ADUPORT_MCP_ALLOWED_ROOTS=

ADUPORT_BASIC_AUTH=

ADUPORT_VIRUS_SCAN=false
ADUPORT_VIRUS_SCAN_FAIL_CLOSED=true
ADUPORT_VIRUS_SCAN_TIMEOUT_SECONDS=60

# Parallel PDF text-layer extract — IGNORED (PDFium not thread-safe; causes macOS SIGTRAP)
ADUPORT_PDF_TEXT_PARALLEL=false
ADUPORT_PDF_TEXT_WORKERS=4

ADUPORT_CACHE_GZIP=true
ADUPORT_CACHE_GZIP_MIN_BYTES=2048

ADUPORT_WARMUP_ON_STARTUP=true

ADUPORT_STREAM_CONVERT=true
ADUPORT_STREAM_CHUNK_CHARS=48000
ADUPORT_STREAM_MIN_BYTES=256000

ADUPORT_HTML_KATEX=true
ADUPORT_TABLE_FIRST_ROW_HEADER=true

# --- Vendored anydoc (native/anydoc/ → aduport_native._doc) ---
# Build once: bash scripts/build_native.sh  (Docker images compile it by default)
# Master switch: off = every native importer behaves exactly as before
ADUPORT_ANYDOC_ENABLED=true
# Shared formats anydoc leads on (comma-separated; *=all). Exclusive formats
# (ppt/xls/xlsb/ods/odp/macro variants) are owned whenever enabled — not `doc`
# (doc has a native importer; include it here to prefer Rust OLE + fast→md).
# xlsx stays with the native importer by default (better header-row inference).
# epub/csv remain native-first until fixture parity grows; add them explicitly if needed.
ADUPORT_ANYDOC_FORMATS=doc,rtf,odt,pptx,ppt,pps,pot,pptm,ppsx,ppsm,docm,epub,csv
# Target=Markdown: return anydoc GFM directly (zero fidelity loss)
ADUPORT_ANYDOC_FAST_MARKDOWN=true
# Text PDF → Markdown via anydoc (pdf-inspector). Scanned pages fall back to
# AduPort OCR/docling. Does NOT put PDF on the AST import path.
ADUPORT_ANYDOC_PDF_MARKDOWN=true
# Recoverable anydoc declines fall back to native importers
ADUPORT_ANYDOC_FALLBACK=true
# Content-based format sniff (OLE/ZIP/PDF/RTF signatures)
ADUPORT_ANYDOC_SNIFF=true

# v9 P2/P3 Markdown export
ADUPORT_HTML_TABLE_FOR_SPAN=true
ADUPORT_LLM_MODE=false
ADUPORT_LLM_MODE_STRIP_IMAGES=true
ADUPORT_LLM_MODE_FRONT_MATTER=true

# Enterprise license (default off for OSS)
ADUPORT_LICENSE_REQUIRED=false
ADUPORT_LICENSE_SECRET=
ADUPORT_LICENSE_KEY=
ADUPORT_LICENSE_FILE=
