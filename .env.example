# md-bridge environment configuration
# Copy to .env and adjust. Prefix: MDBRIDGE_
# Enterprise private deploy: see enterprise/.env.example and enterprise/README.md

MDBRIDGE_MAX_UPLOAD_MB=100
# Optional: scan OCR fixtures (image-only PDFs)
# python scripts/gen_scan_fixtures.py
# pytest -q -m integration tests/test_scan_ocr_regression.py
MDBRIDGE_OCR_ENABLED=false
# auto | mineru | paddleocr_vl | docling — see enterprise/OCR.md
MDBRIDGE_OCR_ENGINE=auto
MDBRIDGE_OCR_MODE=balanced
MDBRIDGE_OCR_FALLBACK=paddleocr_vl
MDBRIDGE_OCR_MIN_CHARS=40
MDBRIDGE_OCR_TIMEOUT_SECONDS=300
MDBRIDGE_OCR_MAX_PAGES=20
MDBRIDGE_MINERU_BIN=mineru
MDBRIDGE_MINERU_BACKEND=pipeline
MDBRIDGE_MINERU_FORMULA=false
MDBRIDGE_MINERU_TABLE=true
# Writable cache for PaddleX / ModelScope (e.g. .paddle_home)
MDBRIDGE_OCR_HOME=
# auto | true | false — auto disables Paddle on macOS (avoids SIGTRAP crash dialogs)
MDBRIDGE_OCR_ALLOW_PADDLE=auto

# PDF engine: auto | text | docling | mineru | paddleocr_vl
MDBRIDGE_PDF_ENGINE=auto
MDBRIDGE_PDF_TEXT_MIN_CHARS=80
# Two-column PDF text heuristic (left/right half merge when both populated)
MDBRIDGE_PDF_TEXT_MULTICOLUMN=true
MDBRIDGE_HF_ENDPOINT=https://hf-mirror.com
MDBRIDGE_DOCLING_OFFLINE=true
MDBRIDGE_DEBUG=false

MDBRIDGE_CORS_ORIGINS=local
MDBRIDGE_CORS_ALLOW_CREDENTIALS=false

# Optional API key (empty = disabled). When set, send header X-API-Key.
MDBRIDGE_API_KEY=
# Multi-tenant: JSON file path, inline JSON, or tenant:key,tenant2:key2
MDBRIDGE_API_KEYS=

MDBRIDGE_PDF_FONT_FAMILY="Noto Sans CJK SC, Helvetica Neue, Arial, sans-serif"
MDBRIDGE_PDF_CUSTOM_CSS=

MDBRIDGE_MAX_BATCH_FILES=20
MDBRIDGE_MAX_BATCH_TOTAL_MB=200
MDBRIDGE_BATCH_WORKERS=3

MDBRIDGE_RATE_LIMIT_PER_MINUTE=60
MDBRIDGE_REDIS_URL=

MDBRIDGE_CACHE_ENABLED=true
MDBRIDGE_CACHE_MAX_ENTRIES=128
MDBRIDGE_CACHE_TTL_SECONDS=3600

MDBRIDGE_AUDIT_ENABLED=true
MDBRIDGE_AUDIT_LOG_PATH=logs/audit.jsonl

MDBRIDGE_MAGIC_BYTES_CHECK=true

MDBRIDGE_PDF_CJK_TYPESET=true
MDBRIDGE_PDF_PAGE_SIZE=A4
MDBRIDGE_PDF_ORIENTATION=portrait
MDBRIDGE_PDF_HEADER=
MDBRIDGE_PDF_FOOTER=
MDBRIDGE_PDF_PAGE_NUMBERS=true
MDBRIDGE_PDF_TOC=false

MDBRIDGE_FETCH_REMOTE_IMAGES=true
MDBRIDGE_FETCH_REMOTE_TIMEOUT=8
MDBRIDGE_FETCH_REMOTE_MAX_BYTES=5242880

MDBRIDGE_SPILL_THRESHOLD_MB=8
MDBRIDGE_CACHE_SKIP_REVALIDATE=true

MDBRIDGE_DOCX_THEME=default
# Soft cap for oversized DOCX AST (enterprise: document in ACCEPTANCE.md)
MDBRIDGE_DOCX_MAX_NODES=50000
# Emit Word comments.xml when AST has Comment nodes (default true)
MDBRIDGE_DOCX_EXPORT_COMMENTS=true
# Prefix headings with 1 / 1.1 / 1.1.1 on export
MDBRIDGE_HEADING_NUMBERING=false

MDBRIDGE_JOB_TTL_SECONDS=3600
MDBRIDGE_JOB_MAX_ENTRIES=256
MDBRIDGE_JOB_DB_PATH=data/jobs.sqlite3
# Persist job result blobs (survives restart within TTL); empty = memory/spill only
MDBRIDGE_JOB_RESULT_DIR=data/job_results
# Long-term archive (file:///path or s3://bucket/prefix; s3 needs boto3)
MDBRIDGE_OBJECT_STORAGE_URI=
MDBRIDGE_JOB_ARCHIVE_RETENTION_DAYS=30
# EPUB zip passphrase (password-protected zips only; not Adobe/LCP DRM)
MDBRIDGE_EPUB_PASSPHRASE=
MDBRIDGE_MEMORY_BUDGET_MB=512

# Job completion webhook (POST /api/jobs Form callback_url)
MDBRIDGE_WEBHOOK_ENABLED=true
MDBRIDGE_WEBHOOK_TIMEOUT_SECONDS=10

MDBRIDGE_BASIC_AUTH=

MDBRIDGE_VIRUS_SCAN=false
MDBRIDGE_VIRUS_SCAN_FAIL_CLOSED=true
MDBRIDGE_VIRUS_SCAN_TIMEOUT_SECONDS=60

# Parallel PDF text-layer extract — IGNORED (PDFium not thread-safe; causes macOS SIGTRAP)
MDBRIDGE_PDF_TEXT_PARALLEL=false
MDBRIDGE_PDF_TEXT_WORKERS=4

MDBRIDGE_CACHE_GZIP=true
MDBRIDGE_CACHE_GZIP_MIN_BYTES=2048

MDBRIDGE_WARMUP_ON_STARTUP=true

MDBRIDGE_STREAM_CONVERT=true
MDBRIDGE_STREAM_CHUNK_CHARS=48000
MDBRIDGE_STREAM_MIN_BYTES=256000

MDBRIDGE_HTML_KATEX=true
MDBRIDGE_TABLE_FIRST_ROW_HEADER=true

# --- Vendored anydoc (native/anydoc/ → mdbridge_native._doc) ---
# Build once: bash scripts/build_native.sh  (Docker images compile it by default)
# Master switch: off = every native importer behaves exactly as before
MDBRIDGE_ANYDOC_ENABLED=true
# Shared formats anydoc leads on (comma-separated; *=all). Exclusive formats
# (ppt/xls/xlsb/ods/odp/macro variants) are owned whenever enabled — not `doc`
# (doc has a native importer; include it here to prefer Rust OLE + fast→md).
# xlsx stays with the native importer by default (better header-row inference).
# epub/csv remain native-first until fixture parity grows; add them explicitly if needed.
MDBRIDGE_ANYDOC_FORMATS=doc,rtf,odt,pptx,ppt,pps,pot,pptm,ppsx,ppsm,docm,epub,csv
# Target=Markdown: return anydoc GFM directly (zero fidelity loss)
MDBRIDGE_ANYDOC_FAST_MARKDOWN=true
# Recoverable anydoc declines fall back to native importers
MDBRIDGE_ANYDOC_FALLBACK=true
# Content-based format sniff (OLE/ZIP/PDF/RTF signatures)
MDBRIDGE_ANYDOC_SNIFF=true

# v9 P2/P3 Markdown export
MDBRIDGE_HTML_TABLE_FOR_SPAN=true
MDBRIDGE_LLM_MODE=false
MDBRIDGE_LLM_MODE_STRIP_IMAGES=true
MDBRIDGE_LLM_MODE_FRONT_MATTER=true

# Enterprise license (default off for OSS)
MDBRIDGE_LICENSE_REQUIRED=false
MDBRIDGE_LICENSE_SECRET=
MDBRIDGE_LICENSE_KEY=
MDBRIDGE_LICENSE_FILE=
